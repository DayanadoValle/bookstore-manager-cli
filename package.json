{
  "name": "book-cli-manual",
  "version": "1.0.0",
  "description": "Sistema CLI para gerenciamento de emprestimo de livros",
  "main": "dist/main.js",
   "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "postinstall": "node scripts/setup.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "nodejs",
    "typescript",
    "postgresql",
    "cli"
  ],
  "author": "Dayana do Valle",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "dotenv": "^16.4.5",
    "pg": "^8.12.0",
    "readline-sync": "^1.4.10"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.6",
    "@types/readline-sync": "^1.4.8",
    "tsx": "^4.19.2",
    "typescript": "^5.5.3"
  }
}
